<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vault_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gen_title"
            android:textColor="@color/vault_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            style="@style/VaultKey.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/vault_teal"
                    android:textIsSelectable="false"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_strength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/vault_text_muted"
                    android:textSize="13sp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/strength_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_length"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/gen_length"
            android:textColor="@color/vault_text" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_length"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:value="16"
            android:valueFrom="4"
            android:valueTo="64" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_upper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/gen_upper"
            android:textColor="@color/vault_text" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_lower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/gen_lower"
            android:textColor="@color/vault_text" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_digits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/gen_digits"
            android:textColor="@color/vault_text" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_symbols"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/gen_symbols"
            android:textColor="@color/vault_text" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_no_ambiguous"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gen_no_ambiguous"
            android:textColor="@color/vault_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_regenerate"
                style="@style/VaultKey.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/gen_regenerate" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy"
                style="@style/VaultKey.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/gen_copy" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
