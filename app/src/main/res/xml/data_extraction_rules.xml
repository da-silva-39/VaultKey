<?xml version="1.0" encoding="utf-8"?>
<!-- Regras de extracção de dados (Android 12+): excluir dados sensíveis
     do backup na nuvem e da transferência entre dispositivos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="vaultkey.db" />
        <exclude domain="sharedpref" path="vaultkey_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="vaultkey.db" />
        <exclude domain="sharedpref" path="vaultkey_secure.xml" />
    </device-transfer>
</data-extraction-rules>
