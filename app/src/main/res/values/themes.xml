<resources>
    <!-- Tema escuro Material3 próprio do VaultKey -->
    <style name="Base.Theme.VaultKey" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/vault_teal</item>
        <item name="colorOnPrimary">#06231F</item>
        <item name="colorPrimaryContainer">@color/vault_teal_dark</item>
        <item name="colorOnPrimaryContainer">@color/vault_text</item>
        <item name="colorSecondary">@color/vault_blue</item>
        <item name="colorOnSecondary">@color/vault_text</item>
        <item name="android:colorBackground">@color/vault_bg</item>
        <item name="colorSurface">@color/vault_surface</item>
        <item name="colorOnSurface">@color/vault_text</item>
        <item name="colorSurfaceVariant">@color/vault_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/vault_text_muted</item>
        <item name="colorError">@color/vault_error</item>
    </style>

    <style name="Theme.VaultKey" parent="Base.Theme.VaultKey" />

    <style name="VaultKey.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/vault_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="VaultKey.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/vault_teal</item>
        <item name="android:textColor">#06231F</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="VaultKey.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/vault_teal</item>
        <item name="android:textColor">@color/vault_teal</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="VaultKey.Button.Danger" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/vault_error</item>
        <item name="android:textColor">#2B0A0A</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="VaultKey.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/vault_teal</item>
        <item name="hintTextColor">@color/vault_text_muted</item>
    </style>
</resources>
